{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/schemas/gc-hci-report.v0.1.schema.json",
  "title": "HCI evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "profile_ref",
    "target_version",
    "finding_refs",
    "counts",
    "readiness",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "gc-hci-report.v0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SATISFIED",
        "NOT_SATISFIED",
        "INCONCLUSIVE",
        "REVIEW_REQUIRED",
        "NOT_APPLICABLE",
        "NOT_EVALUATED"
      ],
      "properties": {
        "SATISFIED": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_SATISFIED": {
          "type": "integer",
          "minimum": 0
        },
        "INCONCLUSIVE": {
          "type": "integer",
          "minimum": 0
        },
        "REVIEW_REQUIRED": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_APPLICABLE": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_EVALUATED": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readiness": {
      "enum": [
        "READY",
        "NOT_READY",
        "UNDETERMINED"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audit_result_ref": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
