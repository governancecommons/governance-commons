{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/schemas/gc-hci-profile.v0.1.schema.json",
  "title": "HCI evaluation profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "target",
    "modality",
    "user_population",
    "tasks",
    "criterion_refs",
    "environment",
    "limitations",
    "approved_by"
  ],
  "properties": {
    "schema": {
      "const": "gc-hci-profile.v0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_or_url",
        "version"
      ],
      "properties": {
        "repository_or_url": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string"
        }
      }
    },
    "modality": {
      "enum": [
        "web",
        "desktop",
        "cli",
        "conversational",
        "other"
      ]
    },
    "user_population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "expertise"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "expertise": {
          "enum": [
            "novice",
            "intermediate",
            "expert",
            "mixed"
          ]
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "starting_state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "starting_state": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "criterion_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    }
  }
}
