{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/schemas/gc-audit.zta-target.v1.schema.json",
  "title": "gc-audit.zta-target.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "target_id",
    "revision",
    "profile_id",
    "resources",
    "actors",
    "trust_boundaries",
    "components",
    "capabilities",
    "control_responsibilities",
    "evidence_manifest_digest"
  ],
  "properties": {
    "schema": {
      "const": "gc-audit.zta-target.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
      }
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "enum": [
        "zta.library.v1",
        "zta.cli-hosted.v1",
        "zta.service.v1"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "identity_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "HUMAN",
              "AGENT",
              "SERVICE",
              "HOST",
              "OTHER"
            ]
          },
          "identity_status": {
            "enum": [
              "ASSERTED",
              "VERIFIED",
              "ANONYMOUS"
            ]
          }
        }
      },
      "uniqueItems": true
    },
    "trust_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_component",
          "destination_component",
          "resource_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_component": {
            "type": "string",
            "minLength": 1
          },
          "destination_component": {
            "type": "string",
            "minLength": 1
          },
          "resource_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "control_responsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "mode",
          "component_id"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "LOCAL",
              "DELEGATED",
              "SHARED",
              "NOT_APPLICABLE"
            ]
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "evidence_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
