{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/schemas/gc-audit.zta-controls.v1.schema.json",
  "title": "gc-audit.zta-controls.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "controls"
  ],
  "properties": {
    "schema": {
      "const": "gc-audit.zta-controls.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "objective",
          "threats",
          "applicability",
          "required_evidence",
          "verification",
          "fail_predicate",
          "severity",
          "remediation_role",
          "standard_mappings"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^ZTA-(0[1-9]|1[0-2])\\.0[12]$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "threats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applicability": {
            "type": "object",
            "required": [
              "capability",
              "predicate"
            ],
            "additionalProperties": false,
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "object",
            "required": [
              "method",
              "sufficiency"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": [
                  "AUTOMATED",
                  "MANUAL",
                  "MIXED"
                ]
              },
              "sufficiency": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "fail_predicate": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "remediation_role": {
            "type": "string",
            "minLength": 1
          },
          "standard_mappings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "description": "Unique control_id and exact 24-control coverage are semantic cross-record invariants."
}
