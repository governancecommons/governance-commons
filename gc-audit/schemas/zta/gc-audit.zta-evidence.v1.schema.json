{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/schemas/gc-audit.zta-evidence.v1.schema.json",
  "title": "gc-audit.zta-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "evidence_id",
    "target_id",
    "revision",
    "control_ids",
    "producer",
    "source_refs",
    "source_digest",
    "method",
    "collected_at",
    "environment",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "gc-audit.zta-evidence.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
      }
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "control_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "identity_status"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "identity_status": {
          "enum": [
            "ASSERTED",
            "VERIFIED"
          ]
        },
        "verification_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "method": {
      "enum": [
        "STATIC_INSPECTION",
        "AUTOMATED_TEST",
        "CI_ATTESTATION",
        "MANUAL_REVIEW",
        "RUNTIME_OBSERVATION",
        "ARCHITECTURE_CONTRACT"
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
