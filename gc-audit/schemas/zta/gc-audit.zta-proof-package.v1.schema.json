{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/schemas/gc-audit.zta-proof-package.v1.schema.json",
  "title": "gc-audit.zta-proof-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "target_id",
    "revision",
    "control_id",
    "authority",
    "checker",
    "requirements",
    "proofs",
    "artifact_origin",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "gc-audit.zta-proof-package.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "control_id": {
      "pattern": "^ZTA-(0[1-9]|1[0-2])\\.0[12]$",
      "type": "string"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "role",
        "trust_reference"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "INDEPENDENT_VERIFIER",
            "RELEASE_AUTHORITY"
          ]
        },
        "trust_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "spec_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "spec_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "evidence_id",
          "checker_result",
          "digest"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "checker_result": {
            "enum": [
              "VERIFIED",
              "FAILED",
              "INCONCLUSIVE"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifact_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_revision",
        "build_reference"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "build_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
