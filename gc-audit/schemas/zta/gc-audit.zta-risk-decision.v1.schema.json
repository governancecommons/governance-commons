{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/schemas/gc-audit.zta-risk-decision.v1.schema.json",
  "title": "gc-audit.zta-risk-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "decision_id",
    "assessment_digest",
    "authority",
    "scope",
    "findings",
    "rationale",
    "residual_risk",
    "review_trigger",
    "expires_at",
    "decision"
  ],
  "properties": {
    "schema": {
      "const": "gc-audit.zta-risk-decision.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
      }
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "authorization_reference"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "authorization_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "residual_risk": {
      "type": "string",
      "minLength": 1
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "REJECT"
      ]
    }
  }
}
