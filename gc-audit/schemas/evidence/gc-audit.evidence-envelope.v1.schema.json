{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc-audit.evidence-envelope.v1",
  "type": "object", "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "signature": {"type": "string", "minLength": 1},
    "payload": {"type": "object", "additionalProperties": false,
      "required": ["domain", "evidence_id", "nonce", "policy_id", "target_id", "revision", "environment", "control_id", "objective_digest", "method", "scope", "producer_key_id", "collected_at", "expires_at", "observation", "observation_digest", "limitations"],
      "properties": {
        "domain": {"const": "gc-audit.evidence-envelope.v1"},
        "evidence_id": {"type": "string", "minLength": 1},
        "nonce": {"type": "string", "minLength": 16},
        "policy_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "control_id": {"type": "string", "pattern": "^ZTA-(0[1-9]|1[0-2])\\.0[12]$"},
        "objective_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "method": {"enum": ["STATIC_INSPECTION", "AUTOMATED_TEST", "CI_ATTESTATION", "MANUAL_REVIEW", "RUNTIME_OBSERVATION", "ARCHITECTURE_CONTRACT"]},
        "scope": {"type": "string", "minLength": 1},
        "producer_key_id": {"type": "string", "minLength": 1},
        "collected_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "observation": {"type": "object", "minProperties": 1},
        "observation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
