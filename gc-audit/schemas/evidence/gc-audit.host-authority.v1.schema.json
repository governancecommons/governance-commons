{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc-audit.host-authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "signature": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "policy_id", "root_key_id", "target_id", "revision", "environment", "catalog_digest", "controls", "producers", "issued_at", "expires_at", "max_evidence_age_seconds", "revoked_evidence_ids"],
      "properties": {
        "domain": {"const": "gc-audit.host-authority.v1"},
        "policy_id": {"type": "string", "minLength": 1},
        "root_key_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "catalog_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "controls": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["control_id", "objective_digest", "methods", "scopes"],
          "properties": {
            "control_id": {"type": "string", "pattern": "^ZTA-(0[1-9]|1[0-2])\\.0[12]$"},
            "objective_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["STATIC_INSPECTION", "AUTOMATED_TEST", "CI_ATTESTATION", "MANUAL_REVIEW", "RUNTIME_OBSERVATION", "ARCHITECTURE_CONTRACT"]}},
            "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }}},
        "producers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["key_id", "public_key_b64", "valid_from", "valid_until"],
          "properties": {
            "key_id": {"type": "string", "minLength": 1},
            "public_key_b64": {"type": "string", "minLength": 1},
            "valid_from": {"type": "string", "format": "date-time"},
            "valid_until": {"type": "string", "format": "date-time"},
            "revoked_at": {"type": ["string", "null"], "format": "date-time"}
          }}},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "max_evidence_age_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
        "revoked_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
